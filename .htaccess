# Deny access to sensitive files
<FilesMatch "^\.env|.*\.sql$|composer\.(json|lock)$|phpunit\.xml\.dist|spark|preload\.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Redirect root requests to /public if the server is misconfigured to point to the root folder
<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

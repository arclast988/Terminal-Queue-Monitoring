# --- PHP/CodeIgniter Specific ---
writable/session/*
!writable/session/index.html
!writable/session/.gitkeep
writable/cache/*
writable/logs/*
writable/debugbar/*

# --- USER UPLOADS & TEMP FILES ---
# Prevent uploading user images, documents, or temporary tokens
writable/uploads/*
!writable/uploads/index.html
!writable/uploads/.gitkeep
writable/sync_token.txt

# --- SENSITIVE DATA (CRITICAL) ---
.env
.env.local
config.php
*.pem
*.key

# --- DEPENDENCIES (CRITICAL) ---
vendor/
node_modules/

# --- OS/System generated files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- DATABASE ---
*.sql
*.sqlite
*.db

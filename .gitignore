# --- PHP/CodeIgniter Runtime ---
writable/session/*
!writable/session/index.html
!writable/session/.gitkeep
writable/cache/*
!writable/cache/index.html
writable/logs/*.log
writable/debugbar/*.json
writable/sync_token.txt
writable/ws_server.pid

# --- USER UPLOADS ---
writable/uploads/*
!writable/uploads/index.html
!writable/uploads/.gitkeep

# --- DEPENDENCIES ---
node_modules/
vendor/

# --- OS/System generated files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- SQLite databases ---
*.sqlite
*.db

# --- Claude Code personal session data ---
.claude/

# --- Numbered SQL backups from phpMyAdmin / Windows (keep only jeepneynvans.sql) ---
jeepneynvans (*).sql

# --- PHPUnit / test artifacts ---
.phpunit.result.cache

# --- Composer self-installer (if dropped into the repo root) ---
composer.phar

# --- Editor / temp swap files ---
*.swp
*.swo
*~
*.bak
*.tmp

# --- Build / packaging artifacts ---
*.zip
*.tar.gz

# --- Local environment / secrets (never commit) ---
.env
